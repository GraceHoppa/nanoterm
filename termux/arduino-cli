#!/data/data/com.termux/files/usr/bin/bash
# arduino-cli for Termux: runs the real one inside a proot-distro Debian
# (Arduino's compiler toolchain is built for glibc and won't run on
# Android's libc directly), in the current directory -- so
# `arduino-cli compile .` just works from a sketch folder.
#
# proot-distro shares the host filesystem by default (Termux home, /sdcard)
# at the same paths, so file paths and the build output match on both
# sides; only the working directory needs passing. Binding $HOME again
# would just print an "overlaps with an existing one" warning. The
# container's own /root stays put: arduino-cli and the board cores live
# there.
#
# Uploading can't happen in there -- proot has no USB access. Use
# `nt -u build/<sketch>.ino.hex` for that.
set -eu

DISTRO="${NANOTERM_DISTRO:-debian}"
REAL=/root/bin/arduino-cli

exec proot-distro login "$DISTRO" --work-dir "$PWD" -- "$REAL" "$@"
