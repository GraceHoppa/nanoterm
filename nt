#!/data/data/com.termux/files/usr/bin/bash
# nt: find the Nano, get USB permission, and open nanoterm on it (Termux).
#
# Usage: nt [-t] [-l FILE]
#   -t       timestamp every received line
#   -l FILE  also log everything to FILE
#
# termux-usb -e takes a single command word, so the options are handed to
# nanoterm through environment variables instead of arguments.
set -eu

# Prefer an installed nanoterm (make install), else one built in $HOME.
NANOTERM="${NANOTERM:-$(command -v nanoterm || echo "$HOME/nanoterm")}"

while getopts tl:h opt; do
    case "$opt" in
        t) export NANOTERM_TIMESTAMPS=1 ;;
        l) export NANOTERM_LOG="$(realpath -m "$OPTARG")" ;;
        *) echo "usage: nt [-t] [-l FILE]" >&2; exit 2 ;;
    esac
done

[ -x "$NANOTERM" ] || { echo "nt: $NANOTERM not found or not executable" >&2; exit 1; }

dev="$(termux-usb -l | grep -o '/dev/bus/usb/[0-9]*/[0-9]*' | head -n 1 || true)"
if [ -z "$dev" ]; then
    echo "nt: no USB device found. Is the Nano plugged in (and the phone unlocked)?" >&2
    exit 1
fi

termux-usb -r "$dev" >/dev/null || { echo "nt: USB permission denied for $dev" >&2; exit 1; }

# -E: pass the fd as $TERMUX_USB_FD. termux-usb may print a harmless
# "ignored null byte" warning when nanoterm exits.
exec termux-usb -E -e "$NANOTERM" "$dev"
